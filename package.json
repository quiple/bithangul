{
  "name": "bithangul",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#app.css": "./src/app.css"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "preview": "vite preview",
    "prepare": "nub --node exec svelte-kit sync && lefthook install",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "test": "nub --node --import ./tests/register.mjs --test tests/*.test.ts"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.57.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "lefthook": "2.0.11",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "paneforge": "^1.0.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.8.1",
      "onFail": "ignore"
    }
  }
}
