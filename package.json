{
  "name": "bithangul",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#app.css": "./src/app.css"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "preview": "vite preview",
    "prepare": "nub --node exec svelte-kit sync && lefthook install",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "test": "nub --node --import ./tests/register.mjs --test tests/*.test.ts"
  },
  "dependencies": {
    "@astryx-svelte/core": "0.5.2",
    "@astryx-svelte/theme-liquid-glass": "0.5.2",
    "@stylexjs/stylex": "^0.19.1"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.61.0",
    "@stylexjs/unplugin": "^0.19.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "lefthook": "2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.8.1",
      "onFail": "ignore"
    }
  }
}
